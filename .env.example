# Để trống khóa thì API chạy chế độ mô phỏng và giao diện hiện banner.
# Không ghi khóa thật vào file này.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://rm7g66d.abc-tunnel.us/v1
OPENAI_MODEL=cx/gpt-6-luna
# Model theo vai. Để trống thì dùng OPENAI_MODEL. Chỉ model nhỏ.
MODEL_PERSONA=cx/gpt-6-luna
MODEL_ANALYST=ag/gemini-3.8-flash-low
MODEL_PLANNER=ag/gemini-3.8-flash-low
MODEL_GUARD=ag/gemini-3.8-flash-low
MODEL_EXTRACT=cx/gpt-5.6-luna
MODEL_SIM=cx/gpt-6-luna
# Một lần đổi sang model nhỏ khác, rồi mới tới Gemini. Trùng model chính thì bỏ qua.
MODEL_PERSONA_FALLBACK=cx/gpt-5.6-luna
MODEL_ANALYST_FALLBACK=cx/gpt-5.6-luna
MODEL_PLANNER_FALLBACK=cx/gpt-5.6-luna
MODEL_GUARD_FALLBACK=cx/gpt-5.6-luna
MODEL_EXTRACT_FALLBACK=cx/gpt-6-luna
MODEL_SIM_FALLBACK=cx/gpt-5.6-luna
# Giây. Hết giờ thì đổi model, không gọi lại cùng model.
TIMEOUT_PERSONA=12
TIMEOUT_ANALYST=18
TIMEOUT_PLANNER=18
TIMEOUT_GUARD=9
TIMEOUT_EXTRACT=30
# Ngân sách riêng cho một lần đổi model, không dùng lại đồng hồ của lần chính.
TIMEOUT_PERSONA_FALLBACK=10
TIMEOUT_ANALYST_FALLBACK=12
TIMEOUT_PLANNER_FALLBACK=12
TIMEOUT_GUARD_FALLBACK=7
TIMEOUT_EXTRACT_FALLBACK=20
# Trần cả lượt, kể cả sửa JSON và đổi model.
TURN_DEADLINE=25
# auto hoặc openai-compatible: router trước, Gemini nếu tunnel 5xx/530/timeout.
# gemini: Gemini trước, router là dự phòng. mock: chỉ cho test.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Để trống, hoặc gemini-3.5-flash. 503 / timeout / 404 thì tự về GEMINI_MODEL.
GEMINI_MODEL_PREFERRED=
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
# Embedding luôn qua Gemini, không qua router.
GEMINI_EMBED_MODEL=gemini-embedding-001
# cautious | normal | persistent
AGENT_AGGRESSIVENESS=normal
ADMIN_TOKEN=
DATABASE_URL=postgresql+psycopg://gianan:gianan@localhost:5433/gianan
