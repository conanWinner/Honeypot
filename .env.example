# Để trống cả hai khóa thì API chạy chế độ mô phỏng và giao diện hiện banner.
# Đường demo thật cần ít nhất GEMINI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
# Để trống, hoặc gemini-3.5-flash. 503 / timeout / 404 thì tự về GEMINI_MODEL.
GEMINI_MODEL_PREFERRED=
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
ADMIN_TOKEN=
DATABASE_URL=postgresql+psycopg://gianan:gianan@localhost:5433/gianan
